---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, type Nav } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  nav?: Nav;
  mermaid?: boolean;
}
const { title, description = SITE.description, type = 'website', nav, mermaid = false } = Astro.props;
const fullTitle = title ? `${title} - ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Pinned to the same major version the Hugo site used, so existing diagrams render the same.
const MERMAID_JS = `
const blocks = document.querySelectorAll('pre > code.language-mermaid');
for (const code of blocks) {
  const pre = document.createElement('pre');
  pre.className = 'mermaid';
  pre.textContent = code.textContent;
  code.parentElement.replaceWith(pre);
}
const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@10.9.8/dist/mermaid.esm.min.mjs');
mermaid.initialize({ startOnLoad: false, theme: 'default' });
await mermaid.run({ querySelector: 'pre.mermaid' });
`;
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href="/images/Bill-coding.svg" />
    <link rel="icon" type="image/x-icon" href="/images/Bill-coding.ico" />
    <link rel="alternate" type="application/rss+xml" href="/index.xml" title={SITE.title} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" />
  </head>
  <body>
    <Header nav={nav} />
    <slot />
    <Footer />
    <script is:inline src="/js/search.js" defer></script>
    <script>
      const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn');
      const siteNav = document.getElementById('site-nav');
      menuBtn?.addEventListener('click', () => {
        const open = siteNav?.classList.toggle('is-open') ?? false;
        menuBtn.setAttribute('aria-expanded', String(open));
      });

      document.querySelectorAll<HTMLButtonElement>('.code-copy').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const code = btn.closest('.code')?.querySelector('pre')?.innerText ?? '';
          try {
            await navigator.clipboard.writeText(code);
            btn.textContent = '已複製';
          } catch {
            btn.textContent = '複製失敗';
          }
          setTimeout(() => (btn.textContent = '複製'), 1600);
        });
      });

      const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.doc-toc a[data-id]')];
      if (tocLinks.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) tocLinks.forEach((a) => a.classList.toggle('is-active', a.dataset.id === e.target.id));
            }
          },
          { rootMargin: '0px 0px -70% 0px' },
        );
        tocLinks.forEach((a) => {
          const h = document.getElementById(a.dataset.id ?? '');
          if (h) io.observe(h);
        });
      }
    </script>
    {mermaid && <script type="module" is:inline set:html={MERMAID_JS} />}
  </body>
</html>
