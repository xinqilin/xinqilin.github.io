---
// Giscus (GitHub Discussions). mapping=pathname, so URLs must stay identical to keep old threads.
---
<section class="comments" aria-label="留言">
  <h2>留言</h2>
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="xinqilin/xinqilin.github.io"
    data-repo-id="MDEwOlJlcG9zaXRvcnkzODA3NTYzNzk="
    data-category="Announcements"
    data-category-id="DIC_kwDOFrHhm84CtLOY"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="light"
    data-lang="zh-TW"
    data-loading="lazy"
    crossorigin="anonymous"
    async></script>
</section>
