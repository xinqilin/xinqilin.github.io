---
import type { Nav } from '../lib/site';
interface Props {
  nav?: Nav;
}
const { nav } = Astro.props;
const links = [
  { id: 'home', href: '/', label: 'Home' },
  { id: 'me', href: '/about/', label: 'Me' },
  { id: 'posts', href: '/posts/', label: 'Posts' },
  { id: 'categories', href: '/categories/', label: 'Categories' },
];
---
<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="/"><img src="/images/Bill-coding.svg" alt="" width="34" height="34" /><span>Bill.Lin's Notes</span></a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="開啟選單">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
    <nav class="nav" id="site-nav" aria-label="網站導覽">
      {links.map((l) => <a href={l.href} aria-current={nav === l.id ? 'page' : undefined}>{l.label}</a>)}
      <div class="search" id="search-container">
        <a href="#" id="search-trigger" aria-label="搜尋">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        </a>
        <input type="search" id="search-input" placeholder="搜尋文章..." aria-label="搜尋文章" />
        <div id="search-results-container"></div>
      </div>
    </nav>
  </div>
</header>
