---
// Avatar with the rainbow ring, hover pulse and sparkle carried over from the Hugo site.
interface Props {
  size?: number;
  alt?: string;
}
const { size = 104, alt = 'Bill Lin' } = Astro.props;
---
<span class="avatar" style={`--size: ${size}px`}>
  <span class="avatar-ring" aria-hidden="true"></span>
  <img src="/images/Bill-coding.svg" alt={alt} width={size} height={size} />
  <svg class="avatar-spark" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 0c.6 6.2 5.8 11.4 12 12-6.2.6-11.4 5.8-12 12-.6-6.2-5.8-11.4-12-12C6.2 11.4 11.4 6.2 12 0z"></path>
  </svg>
</span>
